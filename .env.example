# Copie este archivo como .env.local y complete los valores. Nunca suba .env.local al repositorio.

# Producción: PostgreSQL real.
# DATABASE_URL=postgres://usuario:clave@servidor:5432/erp_hanei

# Desarrollo: sin DATABASE_URL se usa PGlite (PostgreSQL embebido) en esta carpeta.
# PGLITE_DIR=./.data/erp

# Carpeta de los archivos adjuntos (soportes). Debe estar respaldada junto con la base de datos.
# ADJUNTOS_DIR=./.data/adjuntos

# Solo desarrollo local: entra sin iniciar sesion con un usuario de desarrollo con todos los roles (se cambia en /desarrollo/usuario).
# Se ignora siempre con NODE_ENV=production. Quitelo antes de arrancar en produccion y desactive el usuario desarrollo@sin-login.local.
# ERP_SIN_LOGIN=1
